// 3-Bit Magnitude Comparator: Behavioral Model
module comparator_3bit_behavioral (
    input  wire [2:0] A,
    input  wire [2:0] B,
    output reg        A_gt_B,
    output reg        A_eq_B,
    output reg        A_lt_B
);
    always @(*) begin
        A_gt_B = 1'b0;
        A_eq_B = 1'b0;
        A_lt_B = 1'b0;

        if (A > B)
            A_gt_B = 1'b1;
        else if (A == B)
            A_eq_B = 1'b1;
        else
            A_lt_B = 1'b1;
    end
endmodule

// Simple testbench
